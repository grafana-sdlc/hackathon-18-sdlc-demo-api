{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "sdlc-demo-api",
        "labels": {
          "app.kubernetes.io/name": "sdlc-demo-api",
          "app.kubernetes.io/part-of": "sdlc-demo"
        },
        "annotations": {
          "kustomize.toolkit.fluxcd.io/reconcile": "disabled",
          "kustomize.toolkit.fluxcd.io/reconcile-disabled-by": "Lantero",
          "kustomize.toolkit.fluxcd.io/reconcile-disabled-reason": "Temporary grafana-sdlc/sdlc-demo-api walkthrough; managed by scripts/demo.sh"
        },
        "namespace": "sdlc-o11y"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 5,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "sdlc-demo-api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "sdlc-demo-api",
              "app.kubernetes.io/part-of": "sdlc-demo"
            },
            "annotations": {}
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "api",
                "image": "IMAGE_DIGEST",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "sdlc-demo-api",
        "labels": {
          "app.kubernetes.io/name": "sdlc-demo-api",
          "app.kubernetes.io/part-of": "sdlc-demo"
        },
        "annotations": {
          "kustomize.toolkit.fluxcd.io/reconcile": "disabled",
          "kustomize.toolkit.fluxcd.io/reconcile-disabled-by": "Lantero",
          "kustomize.toolkit.fluxcd.io/reconcile-disabled-reason": "Temporary grafana-sdlc/sdlc-demo-api walkthrough; managed by scripts/demo.sh"
        },
        "namespace": "sdlc-o11y"
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "sdlc-demo-api"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    }
  ]
}
